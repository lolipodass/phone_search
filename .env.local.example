# Choose ONE option.

# Option A — secret key (recommended if you have it). Server-only, bypasses RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Option B — publishable key only. Uncomment these and comment out Option A.
# Works with the anon RLS policies in supabase/schema.sql.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Legacy names are also accepted:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
